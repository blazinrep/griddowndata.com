# Cloudflare Pages environment variables (set in the Pages dashboard, never commit secrets)
BASE_URL=https://griddowndata.com

# Stripe (required)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price ID for the $129 Complete Kit (create in your Stripe dashboard)
STRIPE_PRICE_KIT=price_...

# Price ID for the $29 DIY Blueprint PDF (create in your Stripe dashboard)
STRIPE_PRICE_DIY=price_...

# Optional: generic webhook for Zapier / Make / your own endpoint
ORDER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/.../.../

# Optional: email alerts + PDF delivery via SendGrid
SENDGRID_API_KEY=SG.xxx
ALERT_EMAIL=you@example.com
FROM_EMAIL=orders@griddowndata.com
